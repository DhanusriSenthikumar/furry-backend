MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=petstore

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:3000
# Used to build links inside emails (password reset, order confirmation)
FRONTEND_URL=http://localhost:3000

# Session cookie. The frontend proxies this API under its own origin, so the
# cookie is first-party and Lax is right; just turn Secure on over https.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Leave blank to disable Stripe checkout (falls back gracefully with a 503)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Leave blank to disable Razorpay checkout (falls back gracefully with a 503)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Order pricing. Shipping is waived once the discounted subtotal reaches the
# threshold; tax is applied after any coupon discount.
SHIPPING_FLAT_FEE=5.99
FREE_SHIPPING_THRESHOLD=49.0
TAX_RATE=0.08

# How long a password reset link stays valid
RESET_TOKEN_EXPIRE_MINUTES=60

# How many days after delivery a customer can open a return themselves. Staff
# can still refund an older order by hand; this only bounds self-service.
RETURN_WINDOW_DAYS=30

# Only customers who have had the product delivered may review it. Set false to
# let anyone rate anything (the behaviour before verification existed).
REQUIRE_VERIFIED_PURCHASE=true

# Leave SMTP_HOST blank to run without a mail server: emails are printed to the
# backend console instead of being sent, so password reset and order
# confirmation are fully demoable with no credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@furryfriends.test

# Subscriptions. The discount is the trade for the commitment and applies to
# every order the plan places; a delivery whose product is out of stock retries
# daily and pauses after this many consecutive misses.
SUBSCRIPTIONS_ENABLED=true
SUBSCRIPTION_DISCOUNT_PERCENT=10.0
SUBSCRIPTION_MAX_FAILURES=3

# The in-process scheduler that actually places due deliveries. With it off,
# nothing drives the runner except an admin pressing the button at
# /admin/subscriptions, so no repeat delivery is ever placed on its own.
#
# Turn it off only if you are driving POST /admin/subscriptions/run from a real
# scheduler instead — running both at once is safe, since due rows are claimed
# before they are acted on. Note that each web worker starts its own loop, so
# more than one worker means duplicate (harmless) passes.
SUBSCRIPTION_RUNNER_ENABLED=true
SUBSCRIPTION_RUNNER_INTERVAL_MINUTES=60
SUBSCRIPTION_RUNNER_BATCH_LIMIT=100
SUBSCRIPTION_RUNNER_INITIAL_DELAY_SECONDS=30

# The store is also exposed as an MCP server at /mcp. Set MCP_ENABLED=false to
# turn it off entirely. MCP_ALLOWED_HOSTS is the Host allow-list the streamable
# HTTP transport enforces against DNS rebinding — add your API's own hostname
# when you deploy, e.g. "api.yourshop.com,127.0.0.1:*,localhost:*".
MCP_ENABLED=true
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
